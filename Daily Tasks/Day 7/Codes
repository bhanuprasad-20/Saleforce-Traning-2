public class ApplicationService {

    public static void validateEligibility(List<Application__c> applications) {

        Set<Id> studentIds = new Set<Id>();

        for (Application__c app : applications) {
            if (app.Student__c != null) {
                studentIds.add(app.Student__c);
            }
        }

        Set<Id> jobIds = new Set<Id>();

        for (Application__c app : applications) {
            if (app.job__c != null) {
                jobIds.add(app.job__c);
            }
        }

        // Student Map
        Map<Id, Student__c> studentsById = new Map<Id, Student__c>([
            SELECT Id,
                   CGPA__c,
                   Active_Backlogs__c,
                   Branch__c
            FROM Student__c
            WHERE Id IN :studentIds
        ]);

        // Job Map
        Map<Id, Job__c> jobsById = new Map<Id, Job__c>([
            SELECT Id,
                   Name,
                   Department__c,
                   job_Title__c,
                   mimnum_cgp__c,
                   closing_date__c
            FROM Job__c
            WHERE Id IN :jobIds
        ]);

        // Process Applications
        for (Application__c app : applications) {

            Student__c student = studentsById.get(app.Student__c);

            Job__c job = jobsById.get(app.job__c);

            if (student != null && job != null) {

                if (student.CGPA__c >= job.mimnum_cgp__c) {
                    app.Status__c = 'Eligible';
                } else {
                    app.Status__c = 'Rejected';
                }
            }
        }
    }
}
